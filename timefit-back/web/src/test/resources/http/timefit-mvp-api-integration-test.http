# @name 업체예약목록조회_전체
GET {{baseUrl}}/api/business/{{businessId}}/reservations
Authorization: Bearer {{ownerToken}}

> {%
    console.log("\n========================================");
    console.log("[Test 8] 업체용 예약 조회 (리팩터링 테스트)");
    console.log("========================================");
    console.log("\n[08-1] 업체 예약 목록 조회 (전체)");
    if (response.status === 200) {
        console.log("✅ 성공");
        console.log("   - 총 예약:", response.body.data.pagination.totalElements);
        console.log("   - 현재 페이지:", response.body.data.pagination.currentPage);
        console.log("   - 총 페이지:", response.body.data.pagination.totalPages);

        if (response.body.data.reservations && response.body.data.reservations.length > 0) {
            console.log("   - 첫 예약 ID:", response.body.data.reservations[0].reservationId);
            console.log("   - 첫 예약 상태:", response.body.data.reservations[0].status);
        }
    } else {
        console.error("❌ 실패:", response.status);
    }
%}

