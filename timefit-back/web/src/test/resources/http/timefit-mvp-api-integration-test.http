### ================================================================
### [Test 6] 예약 슬롯 API
### ================================================================

# @name 예약슬롯조회_특정날짜_공개
GET {{baseUrl}}/api/business/{{businessId}}/booking-slot?date={{slotQueryDate}}

> {%
    console.log("\n[06-1] 예약 슬롯 조회 - 특정 날짜 (공개)");
    if (response.status === 200) {
        const slots = response.body.data.slots;

        if (slots && slots.length >= 4) {
            // 슬롯 4개 저장
            client.global.set("slotId1", slots[0].slotId);
            client.global.set("slotId2", slots[1].slotId);
            client.global.set("slotId3", slots[2].slotId);
            client.global.set("slotId4", slots[3].slotId);

            console.log("✅ 성공 - 슬롯 4개 저장 완료");
            console.log("   Slot1 (예약1-완료용):", slots[0].slotId);
            console.log("   Slot2 (예약2-거절용):", slots[1].slotId);
            console.log("   Slot3 (예약3-노쇼용):", slots[2].slotId);
            console.log("   Slot4 (예약4-취소용):", slots[3].slotId);

            // 저장 확인
            console.log("\n=== 변수 저장 상태 확인 ===");
            console.log("slotId1:", client.global.get("slotId1") || "❌ 미저장");
            console.log("slotId2:", client.global.get("slotId2") || "❌ 미저장");
            console.log("slotId3:", client.global.get("slotId3") || "❌ 미저장");
            console.log("slotId4:", client.global.get("slotId4") || "❌ 미저장");
        } else {
            console.error("❌ 슬롯 부족! 필요: 4개, 실제:", slots ? slots.length : 0);
            console.error("⚠️ 메뉴 생성 시 slotIntervalMinutes를 60분으로 설정했는지 확인");
            console.error("⚠️ 영업시간이 09:00-18:00 (9시간)이면 최소 9개 슬롯 생성됨");
        }
    } else {
        console.error("❌ 실패:", response.status);
    }
