%}

### ================================================================
### [Setup 0] 동적 날짜 생성
### ================================================================

# @name 동적날짜생성
GET {{baseUrl}}/api/auth/health

> {%
    console.log("\n========================================");
    console.log("[Setup 0] 동적 날짜 생성");
    console.log("========================================");

    const today = new Date();

    // 날짜 포맷팅 함수 (YYYY-MM-DD)
    function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    // 날짜 계산 함수
    function addDays(date, days) {
        const result = new Date(date);
        result.setDate(result.getDate() + days);
        return result;
    }

    // 기본 날짜들
    client.global.set("today", formatDate(today));
    client.global.set("tomorrow", formatDate(addDays(today, 1)));

    // 슬롯 조회용 날짜 (7일 후)
    client.global.set("slotQueryDate", formatDate(addDays(today, 7)));

    // 슬롯 조회 범위용 (3일 후)
    client.global.set("rangeQueryDate", formatDate(addDays(today, 3)));

    // 메뉴 생성용 날짜 범위 (오늘 ~ 30일 후)
    client.global.set("menuStartDate", formatDate(today));
    client.global.set("menuEndDate", formatDate(addDays(today, 30)));

    // 슬롯 일괄 생성용 날짜 (14일 후 ~ 20일 후, 7일간)
    client.global.set("bulkSlotDate1", formatDate(addDays(today, 14)));
    client.global.set("bulkSlotDate2", formatDate(addDays(today, 15)));
    client.global.set("bulkSlotDate3", formatDate(addDays(today, 16)));
    client.global.set("bulkSlotDate4", formatDate(addDays(today, 17)));
    client.global.set("bulkSlotDate5", formatDate(addDays(today, 18)));
    client.global.set("bulkSlotDate6", formatDate(addDays(today, 19)));
    client.global.set("bulkSlotDate7", formatDate(addDays(today, 20)));

    // 예약
    client.global.set("reservationEndDate", formatDate(addDays(today, 30)));

    console.log("✅ 동적 날짜 생성 완료");
    console.log("   - today:", client.global.get("today"));
    console.log("   - slotQueryDate (7일 후):", client.global.get("slotQueryDate"));
    console.log("   - menuStartDate ~ menuEndDate:", client.global.get("menuStartDate"), "~", client.global.get("menuEndDate"));
    console.log("   - bulkSlotDate1 ~ 7:", client.global.get("bulkSlotDate1"), "~", client.global.get("bulkSlotDate7"));
    console.log("========================================\n");
%}

