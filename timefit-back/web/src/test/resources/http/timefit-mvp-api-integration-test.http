    console.log("========================================");
    if (response.status === 200 || response.status === 201) {
        console.log("✅ Owner 회원가입 성공");
    } else {
        console.error("❌ 실패:", response.status);
    }
%}

### ================================================================

# @name Owner로그인
POST {{baseUrl}}/api/auth/signin
Content-Type: application/json

{
  "email": "owner.test@timefit.com",
  "password": "owner1234!"
}

> {%
    console.log("\n========================================");
    console.log("[Setup 1-2] Owner 로그인");
    console.log("   - Status:", response.status);
    console.log("========================================");
    if (response.status === 200 && response.body.data && response.body.data.accessToken) {
        client.global.set("ownerToken", response.body.data.accessToken);
        client.global.set("ownerRefreshToken", response.body.data.refreshToken);
        console.log("✅ Owner 로그인 성공 - Token 저장");
    } else {
        console.error("❌ 실패:", response.status);
    }
%}

