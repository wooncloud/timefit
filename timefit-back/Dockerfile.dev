# Development Dockerfile with hot reload support
FROM amazoncorretto:21

WORKDIR /workspace

# openssl 설치 (JWT 키 생성용)
RUN yum install -y openssl && yum clean all

# Gradle Wrapper 복사 및 권한 설정
COPY gradlew .
COPY gradle gradle/
RUN chmod +x ./gradlew

# 기본 설정 파일들 복사
COPY build.gradle .
COPY settings.gradle .

# 서브모듈 build.gradle 파일들 복사
COPY domain/build.gradle domain/
COPY jpa-common/build.gradle jpa-common/
COPY user/build.gradle user/
COPY web/build.gradle web/

# 의존성 미리 다운로드 (캐시 최적화)
RUN ./gradlew dependencies --no-daemon || true

# 포트 노출
EXPOSE 8080

# entrypoint 스크립트 복사 및 권한 설정 (/workspace 밖에 위치 — 볼륨 마운트에 덮어쓰이지 않도록)
COPY docker-entrypoint-dev.sh /docker-entrypoint-dev.sh
RUN sed -i 's/\r//' /docker-entrypoint-dev.sh && chmod +x /docker-entrypoint-dev.sh

# 개발 서버 실행
ENTRYPOINT ["/docker-entrypoint-dev.sh"]